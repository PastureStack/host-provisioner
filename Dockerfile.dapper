FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive
ARG GO_VERSION=1.27.0
ARG GO_SHA256=675c26c449cbb18fc24b74650de1eabbae6e16f64326fd85a283fb3b58280685
ARG UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu
ENV GOPATH=/go
ENV GOROOT=/usr/local/go
ENV PATH=/usr/local/go/bin:/go/bin:${PATH}
ENV GO111MODULE=on
ENV GOFLAGS=-mod=vendor
ENV GOCACHE=/tmp/go-build-cache
ENV GOTELEMETRY=off
ENV XDG_CONFIG_HOME=/tmp/go-config
ENV GIT_CONFIG_GLOBAL=/tmp/gitconfig

RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i "s|http://archive.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g; s|http://security.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" /etc/apt/sources.list.d/ubuntu.sources; \
    fi; \
    apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        build-essential \
        curl \
        git \
        tar \
        xz-utils && \
    rm -rf /var/lib/apt/lists/* && \
    rm -f /usr/bin/pebble

RUN git config --system --add safe.directory '*'

RUN curl -fsSL -o /tmp/go.tgz "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" && \
    echo "${GO_SHA256}  /tmp/go.tgz" | sha256sum -c - && \
    tar -C /usr/local -xzf /tmp/go.tgz && \
    rm -f /tmp/go.tgz && \
    mkdir -p /go/bin /go/src && \
    go version

ENV DAPPER_SOURCE=/go/src/github.com/PastureStack/host-provisioner
ENV DAPPER_OUTPUT="bin dist"
ENV DAPPER_DOCKER_SOCKET=false
ENV DAPPER_ENV="TAG REPO DOCKER_BUILD_NETWORK UBUNTU_MIRROR"
WORKDIR ${DAPPER_SOURCE}
ENTRYPOINT ["./scripts/entry"]
CMD ["ci"]
